# Agentic_AudioProcess_Module —— 环境变量模板 / environment template
#
# 复制为 .env 后填值；.env 已在 .gitignore，不入库。
#
# 本插件**不需要任何云 API 凭证**：分离全部在本地用 sherpa-onnx 的 UVR 模型完成。
# 这里只留运行时覆盖项。
#
# 优先级 / priority: 进程环境变量 > .env > configs/audioprocess.yaml

# ---- 引擎与运行时（一般不用改）/ engine & runtime ---------------------------
# AUDIOPROCESS_ENGINE=uvr            # uvr | null
# AUDIOPROCESS_MODE=lead_removal     # lead_removal | vocals | accompaniment | both
# AUDIOPROCESS_MODELS_DIR=
# AUDIOPROCESS_OUTPUT_DIR=
# AUDIOPROCESS_NUM_THREADS=4
# AUDIOPROCESS_SERVER_HOST=127.0.0.1
# AUDIOPROCESS_SERVER_PORT=8302
